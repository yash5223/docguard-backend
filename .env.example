MONGODB_URI=
PORT=
# JOIN_LINK_BASE=
# Leave it commented out for now; the server will build join links from whatever host serves the request.

# Cloudinary (free plan) - get these from https://console.cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=

# Brevo (Sendinblue) SMTP - free 300 emails/day. Get these from https://app.brevo.com/settings/keys/smtp
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# No longer used for sending (mailer.js now uses Brevo's HTTP API instead of
# SMTP - see BREVO_API_KEY below). SMTP_FROM above is still used as the
# "from" address. The 4 SMTP_* vars above are safe to delete whenever.
BREVO_API_KEY=

# --- New required secrets for this update ---
# Random string, 32+ characters. Used to sign session tokens (JWT).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Random string, 32+ characters, used to hash Aadhaar numbers for the
# uniqueness check. Can reuse JWT_SECRET's value if you prefer one fewer
# secret to manage, but a separate one is slightly more defense-in-depth.
FIELD_HASH_SECRET=
# Comma-separated list of web origins allowed to call this API from a
# browser (e.g. https://app.docguard.example). Leave blank in development;
# REQUIRED in production or the server will reject all browser requests.
ALLOWED_ORIGINS=
